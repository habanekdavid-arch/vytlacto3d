# Premenné prostredia pre vytlacto3d.sk (nastavujú sa vo Verceli: Settings → Environment Variables).
# Hodnoty sem nikdy nepíš — tento súbor je len prehľad. NEXT_PUBLIC_* sa zapíšu do webu
# pri nasadení, po ich zmene treba web nasadiť znova (Redeploy).

# Databáza a prihlasovanie
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
NEXT_PUBLIC_BASE_URL=
ADMIN_EMAILS=

# Platby (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-maily (SMTP) — odosielateľ a kópie objednávok
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_REPLY_TO=
ADMIN_ORDER_EMAIL=

# Ochrana kontaktného formulára — Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Packeta
PACKETA_API_PASSWORD=
PACKETA_API_URL=
PACKETA_SENDER=

# FLOWii
FLOWII_ENABLED=
FLOWII_API_URL=
FLOWII_API_KEY=
FLOWII_USERNAME=
FLOWII_PASSWORD=
FLOWII_COMPANY_ID=
FLOWII_COMPANY_NAME=

# Instagram (príspevky na webe)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=

# Fakturačné údaje predávajúceho
SELLER_NAME=
SELLER_STREET=
SELLER_CITY=
SELLER_ZIP=
SELLER_COUNTRY=
SELLER_ICO=
SELLER_DIC=
SELLER_IC_DPH=
SELLER_IBAN=
SELLER_SWIFT=
SELLER_BANK=
SELLER_EMAIL=
SELLER_PHONE=

# Plánované úlohy (Vercel Cron)
CRON_SECRET=

# Technický výkres → 3D model cez AI (Claude API, https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Voliteľné: iný model, denný limit generovaní pre celý web (predvolene 100)
DRAWING_AI_MODEL=
DRAWING_AI_DAILY_LIMIT=
# Len lokálne: 1 = ukážkový model bez volania AI (v produkcii sa ignoruje)
DRAWING_AI_MOCK=
