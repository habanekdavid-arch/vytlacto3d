generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  name         String
  email        String   @unique
  passwordHash String
  phone        String?

  accountType  String   @default("PERSON")
  vatPayer     Boolean  @default(false)

  companyName   String?
  ico           String?
  dic           String?
  icDph         String?
  contactPerson String?

  billingStreet  String?
  billingCity    String?
  billingZip     String?
  billingCountry String?

  shippingName    String?
  shippingContact String?
  shippingStreet  String?
  shippingCity    String?
  shippingZip     String?
  shippingCountry String?

  stripeCustomerId String? @unique

  orders Order[]

  communityPosts     CommunityPost[]
  communityComments  CommunityComment[]
  communityReactions CommunityReaction[]
}

model Order {
  id          String   @id @default(cuid())
  orderNumber String?  @unique

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  status      String   @default("PENDING")

  fileKey     String
  fileName    String

  analysis    Json
  config      Json
  pricing     Json

  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  customerEmail String?
  paidTotalEur  Float?

  shippingAddress Json?
  shippingCost    Json?
  shippingMethod  String?

  accountType String?
  phone       String?
  vatPayer    Boolean @default(false)

  companyName   String?
  ico           String?
  dic           String?
  icDph         String?
  contactPerson String?

  billingAddress  Json?
  deliveryAddress Json?

  reminderSentAt DateTime?

  paymentMethod  String   @default("CARD")
  variableSymbol String?  @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  invoices   Invoice[]
  orderItems OrderItem[]

  @@index([orderNumber])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@index([customerEmail])
  @@index([stripeSessionId])
}

model OrderItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fileKey   String
  fileName  String
  analysis  Json
  config    Json
  pricing   Json

  @@index([orderId])
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  type          String   @default("INVOICE") // INVOICE | CREDIT_NOTE
  isTest        Boolean  @default(false)

  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])

  creditNoteForId String?
  creditNoteFor   Invoice?  @relation("CreditNotes", fields: [creditNoteForId], references: [id])
  creditNotes     Invoice[] @relation("CreditNotes")

  issuedAt      DateTime @default(now())
  dueAt         DateTime

  sellerSnapshot   Json
  customerSnapshot Json
  items            Json

  totalNet   Float
  totalVat   Float
  totalGross Float

  variableSymbol  String?
  deliveredAt     DateTime?
  deliveryAddress Json?

  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([invoiceNumber])
}

model BlogPost {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  published   Boolean  @default(true)

  slug        String   @unique
  title       String
  subtitle    String
  description String
  image       String
  publishedAt String
  readingTime String
  featured    Boolean  @default(false)
  sections    Json
  cta         String?
}

model Realizacia {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  published   Boolean  @default(true)

  slug        String   @unique
  title       String
  subtitle    String
  description String
  image       String
  images      String[] @default([])
  category    String
  year        String
  material    String
  size        String
  leadTime    String
  seoKeywords Json
  featured    Boolean  @default(false)
  content     Json
}
// Stav prenosu objednávky do FLOWii. Samostatná tabuľka bez väzby na Order,
// aby jej prípadná neprítomnosť v DB nerozbila žiadny existujúci dotaz.
// orderId ako primárny kľúč = jedna objednávka môže vytvoriť zákazku len raz.
model FlowiiSync {
  orderId         String   @id
  status          String
  attempts        Int      @default(0)
  flowiiPartnerId String?
  flowiiOrderId   String?
  flowiiTaskId    String?
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Automaticky obnovovaný prístupový token pre Instagram API. Pôvodný token je
// vo Verceli (INSTAGRAM_ACCESS_TOKEN); obnovený sa ukladá sem, lebo premennú
// prostredia aplikácia prepísať nevie. sourceHash = otlačok tokenu z Vercelu,
// z ktorého obnovený vznikol — keď sa vo Verceli zmení, použije sa nový.
model InstagramToken {
  id          String   @id
  token       String
  sourceHash  String
  refreshedAt DateTime @default(now())
}

// Komunita — príbehy zákazníkov o ich výtlačkoch. Príspevok sa zobrazí až po
// schválení v administrácii (PENDING → PUBLISHED, prípadne HIDDEN), komentáre
// a reakcie sa zobrazujú hneď. orderId = príspevok k vlastnej objednávke,
// vtedy sa pri ňom ukáže „Overený zákazník“.
model CommunityPost {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status   String   @default("PENDING")
  title    String
  story    String
  images   String[] @default([])
  category String
  material String?
  orderId  String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  comments  CommunityComment[]
  reactions CommunityReaction[]

  @@index([status, createdAt])
  @@index([userId])
}

model CommunityComment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  text   String
  hidden Boolean @default(false)

  postId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// Jedna reakcia od používateľa na príspevok; type = kľúč z COMMUNITY_REACTIONS.
model CommunityReaction {
  createdAt DateTime @default(now())
  type      String

  postId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}
